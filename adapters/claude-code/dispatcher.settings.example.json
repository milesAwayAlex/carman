{
  "env": {
    "DISPATCHER_URL": "http://127.0.0.1:8379",
    "DISPATCHER_PLACE": "host"
  },
  "permissions": {
    "allow": [
      "Bash(dispatcher peers*)",
      "Bash(dispatcher send *)",
      "Bash(dispatcher reply *)",
      "Bash(dispatcher inbox*)",
      "Bash(dispatcher read *)",
      "Bash(dispatcher message *)",
      "Bash(dispatcher watch *)",
      "Bash(dispatcher timed*)",
      "Bash(dispatcher priority*)",
      "Bash(dispatcher account)",
      "Bash(dispatcher whoami*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "dispatcher hook claude-code", "timeout": 10 },
        { "type": "command", "command": "dispatcher hook claude-code --wait 335h", "asyncRewake": true, "rewakeMessage": "A message for this session arrived through the dispatcher (it is not an error):", "rewakeSummary": "A message arrived through the dispatcher", "timeout": 1209600 }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "dispatcher hook claude-code", "timeout": 10 }] }
    ],
    "PostToolBatch": [
      { "hooks": [{ "type": "command", "command": "dispatcher hook claude-code", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "dispatcher hook claude-code", "timeout": 10 },
        { "type": "command", "command": "dispatcher hook claude-code --wait 335h", "asyncRewake": true, "rewakeMessage": "A message for this session arrived through the dispatcher (it is not an error):", "rewakeSummary": "A message arrived through the dispatcher", "timeout": 1209600 }
      ] }
    ],
    "StopFailure": [
      { "hooks": [
        { "type": "command", "command": "dispatcher hook claude-code", "timeout": 10 },
        { "type": "command", "command": "dispatcher hook claude-code --wait 335h", "asyncRewake": true, "rewakeMessage": "A message for this session arrived through the dispatcher (it is not an error):", "rewakeSummary": "A message arrived through the dispatcher", "timeout": 1209600 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "dispatcher hook claude-code", "timeout": 10 }] }
    ]
  }
}
