#!/bin/sh
# Keeps one of the egress proxy's credentials fresh. Runs beside the proxy,
# never in an agent's pod.
#
#   renew-credential KEY SECONDS -- COMMAND...
#   renew-credential --write KEY VALUE        write a value once
#
# COMMAND prints the whole header value (for example "Bearer ..."). It is run
# every SECONDS; when what it prints has changed, the proxy's file for KEY is
# replaced in one step, which is what makes the proxy read it again. A
# command that fails or prints nothing leaves the file as it was. The value
# is never logged.
set -u
# The file is the proxy's own form for a secret it is to read again
# (JSON, which is also YAML), holding the value itself.
write() {
    jq -n --arg name "credential-$1" --arg value "$2" \
        '{resources: [{"@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.Secret", name: $name, generic_secret: {secret: {inline_string: $value}}}]}' \
        > "/renewed/.$1.new" && mv "/renewed/.$1.new" "/renewed/$1.yaml"
}
if [ "$1" = "--write" ]; then write "$2" "$3"; exit $?; fi
key="$1" every="$2"; shift 2
[ "${1:-}" != "--" ] || shift
last="" said=""
say() { [ "$1" = "$said" ] || { echo "renew-credential: $key: $1"; said="$1"; }; }
while true; do
    if value="$("$@" 2>/tmp/renew.err)" && [ -n "$value" ]; then
        if [ "$value" != "$last" ]; then
            write "$key" "$value" && last="$value"
            said=""; say "renewed at $(date -u +%H:%M:%SZ)"
        fi
    else
        say "not renewed: $(tail -c 300 /tmp/renew.err | tr '\n' ' ')"
    fi
    sleep "$every"
done
