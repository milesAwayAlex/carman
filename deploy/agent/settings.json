{
  "env": {
    "CMEM_NOTE_SCOPE": "ask"
  },
  "permissions": {
    "allow": [
      "Bash(cmem recall *)",
      "Bash(cmem get *)",
      "Bash(cmem note *)",
      "Bash(cmem flag *)",
      "Bash(dispatcher peers*)",
      "Bash(dispatcher send *)",
      "Bash(dispatcher reply *)",
      "Bash(dispatcher inbox*)",
      "Bash(dispatcher read *)",
      "Bash(dispatcher message *)",
      "Bash(dispatcher watch *)",
      "Bash(dispatcher whoami*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmem hook claude-code",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "dispatcher hook claude-code",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "dispatcher hook claude-code --wait 335h",
            "asyncRewake": true,
            "timeout": 1209600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmem hook claude-code",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "dispatcher hook claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmem hook claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmem hook claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmem hook claude-code",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "dispatcher hook claude-code",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "dispatcher hook claude-code --wait 335h",
            "asyncRewake": true,
            "timeout": 1209600
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dispatcher hook claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dispatcher hook claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
