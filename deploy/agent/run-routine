#!/bin/sh
# Runs one routine: a prompt under /routines, handed to the harness with the
# memory command as the only thing it may run.
#
#   run-routine NAME...     for example: run-routine consolidate distill
#
# From the environment: CMEM_URL and CMEM_TOKEN (the role the routine works
# in), the harness's own model credential, CMEM_ROUTINE_MODELS (the ladder of
# models, in order) and CMEM_ROUTINE_BUDGET_USD (what one run may spend).
set -eu
[ $# -gt 0 ] || { echo "run-routine: name a routine, for example: consolidate" >&2; exit 2; }
[ -n "${CMEM_URL:-}" ] && [ -n "${CMEM_TOKEN:-}" ] || { echo "run-routine: CMEM_URL and CMEM_TOKEN must be set" >&2; exit 2; }

# The session hook and the harness's own memory are for working sessions.
export CMEM_HOOK=off CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 DISABLE_AUTOUPDATER=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# Where the egress proxy answers in a host's name, its certificate comes from
# an authority of this installation. Trust it beside the public ones, for every kind of
# program an agent runs.
if [ -f "${EGRESS_CA:-/nonexistent}" ]; then
    cat /etc/ssl/certs/ca-certificates.crt "$EGRESS_CA" > /tmp/ca-bundle.crt
    export NODE_EXTRA_CA_CERTS="$EGRESS_CA" SSL_CERT_FILE=/tmp/ca-bundle.crt CURL_CA_BUNDLE=/tmp/ca-bundle.crt \
        GIT_SSL_CAINFO=/tmp/ca-bundle.crt REQUESTS_CA_BUNDLE=/tmp/ca-bundle.crt
fi
# A cloud provider's command-line tools take their identity from a file the
# chart mounts when the agent has one (ADR 0031): no key, a token exchanged
# for the pod's own.
if [ -f "${GOOGLE_APPLICATION_CREDENTIALS:-/nonexistent}" ] && command -v gcloud >/dev/null; then
    gcloud auth login --quiet --cred-file="$GOOGLE_APPLICATION_CREDENTIALS" >/dev/null 2>&1 ||
        echo "run-routine: the cloud identity could not be set up; cloud commands will fail" >&2
fi
# A published image carries no harness (see the Dockerfile): fetch the version
# the image was built for, into the pod's own home.
if ! command -v claude >/dev/null; then
    echo "run-routine: fetching the harness, version $HARNESS_VERSION"
    npm install -g --prefix "$HOME/.harness" --no-fund --no-audit --no-update-notifier --loglevel=error "@anthropic-ai/claude-code@$HARNESS_VERSION" ||
        { echo "run-routine: the harness could not be fetched" >&2; exit 1; }
    export PATH="$HOME/.harness/bin:$PATH"
    claude --version >/dev/null || { echo "run-routine: the harness was fetched and does not run" >&2; exit 1; }
fi
# Plugins the agent was given: skills, subagents and MCP servers that come as
# one package. Fetched now, so a run has each as it is today. One that cannot
# be installed is said so here and the run goes on without it.
for marketplace in ${AGENT_MARKETPLACES:-}; do
    claude plugin marketplace add "$marketplace" >/dev/null 2>&1 || echo "run-routine: the plugin marketplace $marketplace could not be added" >&2
done
for plugin in ${AGENT_PLUGINS:-}; do
    if claude plugin install "$plugin" --scope user >/dev/null 2>&1; then echo "run-routine: plugin $plugin"; else echo "run-routine: the plugin $plugin could not be installed; the run goes on without it" >&2; fi
done
# Commands of this installation's own (scripts/deploy.sh CONTEXT tool FILE).
[ ! -d /etc/agent/bin ] || export PATH="/etc/agent/bin:$PATH"
failed=0
for routine in "$@"; do
    # A routine that belongs to one installation is in the cluster, not in
    # the image; it wins over one of the same name that is.
    file="/etc/agent/routines/$routine.md"
    [ -f "$file" ] || file="/routines/$routine.md"
    [ -f "$file" ] || { echo "run-routine: no routine named $routine" >&2; exit 2; }
    echo "run-routine: $routine, models ${CMEM_ROUTINE_MODELS:-claude-sonnet-5-5}, budget \$${CMEM_ROUTINE_BUDGET_USD:-none} for this routine, memory at $CMEM_URL"
    # `cmem routine` runs the harness, and runs it again up the ladder of
    # models for whatever memory refused and was not then done (ADR 0029).
    # One routine that does not finish does not stop the next.
    cmem routine "$file" || failed=1
    echo
done
exit $failed
