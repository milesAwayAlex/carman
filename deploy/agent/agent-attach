#!/bin/sh
# Attaches the terminal it is run from to the agent's tmux session, making
# one if there is none. Detach with the tmux prefix and d; the session and
# whatever runs in it go on.
. /usr/local/lib/agent-env
# The terminal's own kind, when this image knows it: colours and the
# clipboard depend on it. Otherwise one that is known everywhere.
if [ -n "${AGENT_TERM:-}" ] && infocmp "$AGENT_TERM" >/dev/null 2>&1; then TERM="$AGENT_TERM"; else TERM=xterm-256color; fi
export TERM
mkdir -p "$HOME/work" && cd "$HOME/work"
exec tmux -u new-session -A -s main
