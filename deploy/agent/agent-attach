#!/bin/sh
# Attaches the terminal it is run from to the agent's tmux session, making
# one if there is none. Detach with the tmux prefix and d; the session and
# whatever runs in it go on.
. /usr/local/lib/agent-env
# The terminal's own kind, when this image knows it: colours and the
# clipboard depend on it. Otherwise one that is known everywhere.
if [ -n "${AGENT_TERM:-}" ] && infocmp "$AGENT_TERM" >/dev/null 2>&1; then TERM="$AGENT_TERM"; else TERM=xterm-256color; fi
export TERM
# A pod that has only just started is still being set up. Attaching now
# would start tmux before the installation's configuration is in the home,
# and the session would keep the old one. Wait for it.
waited=0
while [ ! -f /tmp/agent-session-ready ] && [ "$waited" -lt 180 ]; do
    [ "$waited" -gt 0 ] || echo "the agent is still starting; waiting for it"
    sleep 1
    waited=$((waited + 1))
done
mkdir -p "$HOME/work" && cd "$HOME/work"
# One client for each place that attaches. When a connection is dropped
# without a hang-up (the far end's terminal went away), the client it left
# here goes on, attached to nothing. The next attach from the same place
# ends it first. Other places' clients are left alone.
if [ -n "${AGENT_ATTACH_ID:-}" ]; then
    mark="/tmp/agent-attach/$(printf %s "$AGENT_ATTACH_ID" | tr -c 'A-Za-z0-9._-' '_')"
    mkdir -p /tmp/agent-attach
    old="$(cat "$mark" 2>/dev/null || true)"
    if [ -n "$old" ] && [ "$old" != "$$" ] && grep -q tmux "/proc/$old/cmdline" 2>/dev/null; then
        kill -HUP "$old" 2>/dev/null || true
    fi
    echo "$$" > "$mark"
fi
exec tmux -u new-session -A -s main
