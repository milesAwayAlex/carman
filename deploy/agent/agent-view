#!/bin/sh
# One client's view of one session of a standing agent's pod (ADR 0057):
# what the command that goes to a session runs here. The pod's tmux session `main` has a window for
# each harness session; clients attached to one tmux session share its
# current window, so each view is a session of its own in main's group,
# showing the one window, and removed when its client goes.
#
#   agent-view ID [NAME]    the window of the session with that id (by its harness's
#                           process), or the window called NAME; a session that is
#                           not running and is remembered is opened again first
#   agent-view --beat       says, for as long as lines arrive on its input, that the
#                           far end of the view with the same AGENT_ATTACH_ID is there
#
# A dropped connection does not hang the view's client up: it would stay
# attached to nothing. Whoever attaches with AGENT_VIEW_BEAT set promises to
# run `agent-view --beat` beside it and write it a line now and then; a view
# whose beat has been silent for AGENT_VIEW_SILENCE seconds (90) is ended.
# With no AGENT_VIEW_BEAT a view lives until its client goes, or until the
# next attach with the same AGENT_ATTACH_ID.
#
# In a view there is no status line and no prefix key: it is meant to sit in
# a window of the tmux of whoever attached, which is then the only one they
# drive. `main` itself is untouched, for agent-attach and the pod's watcher.
# Ends with 0 when the view was left (the client went, or the session's
# window closed), 3 when there is nothing to show.
set -eu
[ ! -r /usr/local/lib/agent-env ] || . /usr/local/lib/agent-env
marks="${AGENT_ATTACH_DIR:-/tmp/agent-attach}"
mark="$marks/$(printf %s "view-${AGENT_ATTACH_ID:-none}" | tr -c 'A-Za-z0-9._-' '_')"
if [ "${1:-}" = --beat ]; then
    [ -n "${AGENT_ATTACH_ID:-}" ] || { echo "agent-view --beat: AGENT_ATTACH_ID says which view" >&2; exit 2; }
    mkdir -p "$marks"
    echo "$$" > "$mark.beat"
    date +%s > "$mark.alive"
    while IFS= read -r _; do date +%s > "$mark.alive"; done
    exit 0
fi
id="${1:-}" name="${2:-}"
[ -n "$id$name" ] || { echo "usage: agent-view ID [NAME]" >&2; exit 2; }
if [ -n "${AGENT_TERM:-}" ] && infocmp "$AGENT_TERM" >/dev/null 2>&1; then TERM="$AGENT_TERM"; else TERM=xterm-256color; fi
export TERM
# The pod's tmux, by its own program and socket (as agent-open finds it).
sock="${AGENT_TMUX_SOCKET:-/tmp/tmux-$(id -u)/default}"
bin="${AGENT_TMUX:-$(cat /tmp/agent-tmux 2>/dev/null || echo tmux)}"
t() { "$bin" -S "$sock" "$@"; }
t has-session -t main 2>/dev/null || { echo "agent-view: this pod has no tmux session yet" >&2; exit 3; }

# The window of a session's harness: the pane that is an ancestor of the
# process its SessionStart hook recorded.
window_of() {
    record="${AGENT_HARNESS_DIR:-/tmp/agent-harness}/$1"
    [ -r "$record" ] || return 1
    pid="$(cut -d' ' -f1 "$record")"
    panes="$(t list-panes -s -t main -F '#{pane_pid} #{window_id}')"
    hops=0
    while [ "${pid:-0}" -gt 1 ] && [ "$hops" -lt 8 ]; do
        found="$(printf '%s\n' "$panes" | awk -v p="$pid" '$1 == p {print $2; exit}')"
        [ -z "$found" ] || { echo "$found"; return 0; }
        pid="$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null || echo 0)"
        hops=$((hops + 1))
    done
    return 1
}
named() { t list-windows -t main -F '#{window_name} #{window_id}' | awk -v n="$1" '$1 == n {print $2; exit}'; }

window=""
[ -z "$id" ] || window="$(window_of "$id" || true)"
if [ -z "$window" ] && [ -n "$name" ]; then
    # Not running by that id: the window of its name, with the session
    # opened again in it if this pod remembers it (as for a message).
    ! command -v agent-open >/dev/null || agent-open --reopen "$name" >/dev/null 2>&1 || true
    window="$(named "$name")"
fi
[ -n "$window" ] || { echo "agent-view: no window here for session ${name:-$id}; agent-open NAME DIR opens one" >&2; exit 3; }

# One view for each place that attaches to this session: a client that a
# dropped connection left behind is ended by the next attach from there.
if [ -n "${AGENT_ATTACH_ID:-}" ]; then
    mkdir -p "$marks"
    old="$(cat "$mark" 2>/dev/null || true)"
    if [ -n "$old" ] && [ "$old" != "$$" ] && grep -q tmux "/proc/$old/cmdline" 2>/dev/null; then
        kill -HUP "$old" 2>/dev/null || true
        sleep 0.2
    fi
    echo "$$" > "$mark"
    if [ -n "${AGENT_VIEW_BEAT:-}" ]; then
        # Beside the client (this process, once it is tmux): ends it when
        # its far end has said nothing for too long, and the beat's reader
        # with it, which a drop leaves waiting too.
        date +%s > "$mark.alive"
        client=$$ silence="${AGENT_VIEW_SILENCE:-90}"
        (
            while sleep "${AGENT_VIEW_LOOK:-15}"; do
                kill -0 "$client" 2>/dev/null && [ "$(cat "$mark" 2>/dev/null)" = "$client" ] || exit 0
                heard="$(cat "$mark.alive" 2>/dev/null || echo 0)"
                [ $(( $(date +%s) - heard )) -le "$silence" ] && continue
                kill -HUP "$client" 2>/dev/null || true
                beat="$(cat "$mark.beat" 2>/dev/null || true)"
                [ -z "$beat" ] || kill "$beat" 2>/dev/null || true
                exit 0
            done
        ) </dev/null >/dev/null 2>&1 &
    fi
fi
# Views nobody is attached to are removed by themselves; one left by a
# server that was told so too late is removed here.
for stale in $(t list-sessions -F '#{session_name} #{session_attached}' | awk '$1 ~ /^view-/ && $2 == 0 {print $1}'); do
    t kill-session -t "$stale" 2>/dev/null || true
done

view="view-$$"
# One command, so that the options are the view's from its first moment,
# and so that this process is the client (the mark above is the client's).
# - destroy-unattached: the view goes when its client does;
# - no status line and no prefix: the tmux of whoever attached is the only
#   one in their way;
# - the mouse: the wheel scrolls back through the session's own history,
#   which with no prefix has no other way in;
# - the hook: the view is of this window; when it closes, the view ends,
#   and does not go on to show a neighbour's. Looked at once more at the
#   end, for a window that closed while these were being set.
exec "$bin" -S "$sock" -u new-session -s "$view" -t main \; \
    set-option destroy-unattached on \; \
    set-option status off \; \
    set-option prefix None \; \
    set-option prefix2 None \; \
    set-option mouse on \; \
    select-window -t "$window" \; \
    set-hook session-window-changed "if-shell -F '#{!=:#{window_id},$window}' 'kill-session'" \; \
    if-shell -F "#{!=:#{window_id},$window}" kill-session
