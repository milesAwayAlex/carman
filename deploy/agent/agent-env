# What every agent in this image needs before the harness starts, whether it
# runs a routine or a person is at its keyboard. Sourced, not run:
#
#   . agent-env        the environment: trust in the proxy, where tools are
#   agent_setup        what takes a moment: the cloud identity, the harness
#                      (linked from a warm image, or installed), the plugins
#                      the agent was given

# The harness's own memory is off: there is one memory, and the hook that
# agent_setup puts in the harness's settings is how it reaches the agent.
# The harness keeps itself up to date, as its vendor's installer sets it up
# to; what it would otherwise send about its use is off.
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 DISABLE_BUG_COMMAND=1
# Where the egress proxy answers in a host's name, its certificate comes from
# an authority of this installation. Trust it beside the public ones, for
# every kind of program an agent runs.
if [ -f "${EGRESS_CA:-/nonexistent}" ]; then
    cat /etc/ssl/certs/ca-certificates.crt "$EGRESS_CA" > /tmp/ca-bundle.crt
    export NODE_EXTRA_CA_CERTS="$EGRESS_CA" SSL_CERT_FILE=/tmp/ca-bundle.crt CURL_CA_BUNDLE=/tmp/ca-bundle.crt \
        GIT_SSL_CAINFO=/tmp/ca-bundle.crt REQUESTS_CA_BUNDLE=/tmp/ca-bundle.crt
fi
# Commands of this installation's own (scripts/deploy.sh CONTEXT tool FILE),
# and the harness where its installer puts it.
export PATH="/etc/agent/bin:$HOME/.local/bin:$PATH"

# The harness's own state (~/.claude.json), so that a new home starts at the
# prompt with nobody at the keyboard: its first-start screens (the theme and
# the security notes) are taken as seen, and the directory given, if any, as
# trusted. Only what is missing is added; a file that does not read is left.
agent_harness_state() {  # [DIR]
    AGENT_TRUST_DIR="${1:-}" python3 - <<'PY' || echo "agent: the harness's state could not be written; it may ask its first-start questions" >&2
import json, os
path = os.path.realpath(os.path.expanduser("~/.claude.json"))
try:
    state = json.load(open(path))
except FileNotFoundError:
    state = {}
before = json.dumps(state, sort_keys=True)
state.setdefault("hasCompletedOnboarding", True)
trust = os.environ.get("AGENT_TRUST_DIR")
if trust:
    project = state.setdefault("projects", {}).setdefault(os.path.realpath(trust), {})
    project["hasTrustDialogAccepted"] = True
if json.dumps(state, sort_keys=True) != before:
    # Whole or not at all: the harness of another session reads it too.
    with open(path + ".agent", "w") as f:
        json.dump(state, f, indent=2)
    os.chmod(path + ".agent", os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o600)
    os.replace(path + ".agent", path)
PY
}

# The harness's settings in the home: the image's hooks and allow rules
# beside what the user has set. ARG: the harness was linked from the image.
agent_harness_settings() {  # [FROM-IMAGE]
    AGENT_HARNESS_FROM_IMAGE="${1:-}" python3 - <<'PY' || echo "agent: the harness's settings could not be written; it starts without the memory hook" >&2
import json, os
# A harness linked from the image: what its installer records about how it
# was installed, which the installer would have written here.
if os.environ.get("AGENT_HARNESS_FROM_IMAGE"):
    state_path = os.path.expanduser("~/.claude.json")
    try:
        state = json.load(open(state_path))
    except Exception:
        state = {}
    for key, value in (("installMethod", "native"), ("autoUpdates", False), ("autoUpdatesProtectedForNative", True)):
        state.setdefault(key, value)
    json.dump(state, open(state_path, "w"), indent=2)
path = os.path.expanduser("~/.claude/settings.json")
try:
    settings = json.load(open(path))
except Exception:
    settings = {}
ours = json.load(open(os.environ.get("AGENT_SETTINGS", "/usr/local/lib/agent-settings.json")))
settings["autoUpdatesChannel"] = os.environ.get("HARNESS_CHANNEL") or "stable"
settings.setdefault("env", {}).update(ours.get("env", {}))
allow = settings.setdefault("permissions", {}).setdefault("allow", [])
# A restricted job has what cmem routine allows it and nothing more: rules
# here would add to its own (ADR 0061).
restricted = not os.environ.get("AGENT_INTERACTIVE") and os.environ.get("CMEM_ROUTINE_TOOLS") != "all"
if not restricted:
    allow += [rule for rule in ours.get("permissions", {}).get("allow", []) if rule not in allow]
settings["hooks"] = {**settings.get("hooks", {}), **ours.get("hooks", {})}
mode = os.environ.get("AGENT_PERMISSION_MODE")
if mode:
    settings["permissions"]["defaultMode"] = mode
json.dump(settings, open(path, "w"), indent=2)
PY
}

agent_setup() {
    # A cloud provider's command-line tools take their identity from a file
    # the chart mounts when the agent has one (ADR 0031): no key, a token
    # exchanged for the pod's own.
    if [ -f "${GOOGLE_APPLICATION_CREDENTIALS:-/nonexistent}" ] && command -v gcloud >/dev/null; then
        gcloud auth login --quiet --cred-file="$GOOGLE_APPLICATION_CREDENTIALS" >/dev/null 2>&1 ||
            echo "agent: the cloud identity could not be set up; cloud commands will fail" >&2
    fi
    # What the installation's own base image wants done at each start, such
    # as putting its shell's configuration and its tools in the home. Jobs
    # and standing pods alike: an agent has the same tools either way.
    for step in /usr/local/lib/agent-start.d/*; do
        [ -x "$step" ] || continue
        "$step" >/dev/null || echo "agent: $step did not finish" >&2
    done
    # Where the installation gives agents a namespace to run things in, the
    # pod's own account is somebody there: a kubectl context named sandbox,
    # beside whatever contexts the agent makes for clusters elsewhere.
    sa=/var/run/secrets/kubernetes.io/serviceaccount
    if [ -n "${AGENT_SANDBOX:-}" ] && [ -r "$sa/token" ] && command -v kubectl >/dev/null; then
        kubectl config set-cluster sandbox --server=https://kubernetes.default.svc --certificate-authority="$sa/ca.crt" >/dev/null &&
            kubectl config set users.sandbox.tokenFile "$sa/token" >/dev/null &&
            kubectl config set-context sandbox --cluster=sandbox --user=sandbox --namespace="$AGENT_SANDBOX" >/dev/null ||
            echo "agent: the sandbox context could not be set up" >&2
        [ -n "$(kubectl config current-context 2>/dev/null)" ] || kubectl config use-context sandbox >/dev/null
    fi
    # The harness is installed here by its vendor's own installer, from the
    # channel named (stable unless HARNESS_CHANNEL says otherwise), so an
    # agent has what a person who installed it today would have. A job's home
    # is new each time, so a job gets the channel's current version; a home
    # that outlives the pod keeps its copy, which updates itself. If the
    # installer cannot be reached, an image that carries a copy uses that.
    #
    # A warm image (ADR 0041) carries what the installer left in a home when
    # the image was made, outside the home, since the home is a volume over
    # it: a job's home gets the links the installer makes, in a moment, if
    # that copy runs. An interactive agent's home keeps the copy it has.
    harness_from_image=""
    warm=/usr/local/lib/agent-harness
    if [ ! -x "$HOME/.local/bin/claude" ] && [ -z "${AGENT_INTERACTIVE:-}" ] && [ -x "$warm/claude" ] && [ -r "$warm/version" ]; then
        v="$(cat "$warm/version")"
        mkdir -p "$HOME/.local/bin" "$HOME/.local/share/claude/versions"
        ln -sfn "$warm/claude" "$HOME/.local/share/claude/versions/$v"
        ln -sfn "$HOME/.local/share/claude/versions/$v" "$HOME/.local/bin/claude"
        if [ "$("$HOME/.local/bin/claude" --version 2>/dev/null | cut -d' ' -f1)" = "$v" ]; then
            harness_from_image=1
            echo "agent: harness $v, $(cat "$warm/channel" 2>/dev/null || echo "${HARNESS_CHANNEL:-stable}") channel, from the image"
        else
            rm -f "$HOME/.local/bin/claude" "$HOME/.local/share/claude/versions/$v"
            echo "agent: the image's harness $v does not run; installing it" >&2
        fi
    fi
    if [ ! -x "$HOME/.local/bin/claude" ]; then
        if curl -fsSL https://claude.ai/install.sh | bash -s "${HARNESS_CHANNEL:-stable}" >/tmp/harness-install.log 2>&1; then
            echo "agent: harness $("$HOME/.local/bin/claude" --version 2>/dev/null | cut -d' ' -f1), ${HARNESS_CHANNEL:-stable} channel"
        elif command -v claude >/dev/null; then
            echo "agent: the harness's installer could not be reached; using the image's copy, $(claude --version | cut -d' ' -f1)" >&2
        else
            echo "agent: the harness could not be installed: $(tail -c 300 /tmp/harness-install.log | tr '\n' ' ')" >&2
            return 1
        fi
    fi
    # The harness's settings for whoever starts it here: the memory hook (the
    # index when a session starts, a flashback where a memory is likely to
    # matter), and how it treats what it is about to do. They go in the user's
    # own settings because a machine-wide file is not read when the account's
    # organisation sends settings of its own. What the user has set stays.
    mkdir -p "$HOME/.claude"
    # Where the installation keeps a job's conversations after its pod is
    # gone: the harness writes them there by this link.
    if [ -d /var/lib/agent/conversations ] && [ ! -e "$HOME/.claude/projects" ]; then
        ln -s /var/lib/agent/conversations "$HOME/.claude/projects"
    fi
    agent_harness_settings "$harness_from_image"
    agent_harness_state
    # Plugins the agent was given: skills, subagents and MCP servers that come
    # as one package. Fetched now, so the agent has each as it is today; where
    # the home outlives the pod, what is there already is brought up to date.
    # One that cannot be installed is said so and the agent goes on without it.
    for marketplace in ${AGENT_MARKETPLACES:-}; do
        claude plugin marketplace add "$marketplace" >/dev/null 2>&1 || claude plugin marketplace update >/dev/null 2>&1 ||
            echo "agent: the plugin marketplace $marketplace could not be added" >&2
    done
    for plugin in ${AGENT_PLUGINS:-}; do
        if claude plugin install "$plugin" --scope user >/dev/null 2>&1; then
            claude plugin update "$plugin" >/dev/null 2>&1 || true
            echo "agent: plugin $plugin"
        else
            echo "agent: the plugin $plugin could not be installed; the agent goes on without it" >&2
        fi
    done
}
