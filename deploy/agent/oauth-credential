#!/usr/bin/env python3
"""Keeps a person's sign-in to a service that uses OAuth, beside the egress proxy.

    oauth-credential signin KEY URL [--port N] [--client-id ID]
    oauth-credential token KEY
    oauth-credential status KEY

Some services have no key to hand out: a person signs in in a browser, and
the service gives a token that lasts an hour and another that renews it (a
remote MCP server is the usual case). `signin` does that once. It finds how
the service wants to be signed in to from the service itself, registers as a
client, prints an address to open in a browser, and waits for the browser to
come back to it on this machine's own port N. `token` prints the header value
for the proxy ("Bearer ..."), renewing first when little time is left; it is
what a renewal runs (renew-credential). `status` says when the sign-in was
made and when the token runs out, and no secret.

What is kept is in the home of the renewal, which no agent can reach. No
token is ever printed, except by `token` to the renewal that asked.
"""
import base64, fcntl, hashlib, http.server, json, os, re, secrets, sys, time
import urllib.error, urllib.parse, urllib.request

MARGIN = 300  # renew when fewer seconds than this are left


def die(text, code=1):
    print(f"oauth-credential: {text}", file=sys.stderr)
    sys.exit(code)


def store_path(key):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", key):
        die("a key is letters, digits, dots, dashes and underscores")
    return os.path.join(os.environ.get("OAUTH_STORE", os.path.expanduser("~/oauth")), key + ".json")


def load(key):
    try:
        with open(store_path(key)) as f:
            return json.load(f)
    except FileNotFoundError:
        die(f"{key}: not signed in yet; sign in with: scripts/deploy.sh CONTEXT signin {key} URL")


def save(key, kept):
    path = store_path(key)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(kept, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(path + ".new", path)


def locked(key):
    """One at a time: a renewal token can be used once."""
    path = store_path(key) + ".lock"
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    f = open(path, "w")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def get(url, body=None, form=None, quiet=False):
    """(status, headers, parsed body or text). Never raises for an HTTP status."""
    data, headers = None, {"Accept": "application/json, text/event-stream", "User-Agent": "oauth-credential"}
    if body is not None:
        data, headers["Content-Type"] = json.dumps(body).encode(), "application/json"
    if form is not None:
        data, headers["Content-Type"] = urllib.parse.urlencode(form).encode(), "application/x-www-form-urlencoded"
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data, headers=headers), timeout=30) as r:
            status, head, text = r.status, r.headers, r.read().decode(errors="replace")
    except urllib.error.HTTPError as e:
        status, head, text = e.code, e.headers, e.read().decode(errors="replace")
    except Exception as e:
        if quiet:
            return 0, {}, str(e)
        die(f"{urllib.parse.urlsplit(url).netloc} could not be reached: {e}")
    try:
        return status, head, json.loads(text)
    except Exception:
        return status, head, text


def discover(url):
    """How the service at url wants to be signed in to."""
    parts = urllib.parse.urlsplit(url)
    origin = f"{parts.scheme}://{parts.netloc}"
    status, head, _ = get(url, body={"jsonrpc": "2.0", "id": 1, "method": "ping"})
    named = re.search(r'resource_metadata="([^"]+)"', head.get("WWW-Authenticate", "") if head else "")
    about = None
    for guess in ([named.group(1)] if named else []) + [origin + "/.well-known/oauth-protected-resource" + parts.path,
                                                        origin + "/.well-known/oauth-protected-resource"]:
        s, _, d = get(guess, quiet=True)
        if s == 200 and isinstance(d, dict) and d.get("authorization_servers"):
            about = d
            break
    issuer = about["authorization_servers"][0] if about else origin
    resource = (about or {}).get("resource") or url
    ip = urllib.parse.urlsplit(issuer)
    base = f"{ip.scheme}://{ip.netloc}"
    for guess in (base + "/.well-known/oauth-authorization-server" + ip.path.rstrip("/"),
                  issuer.rstrip("/") + "/.well-known/oauth-authorization-server",
                  base + "/.well-known/openid-configuration" + ip.path.rstrip("/"),
                  issuer.rstrip("/") + "/.well-known/openid-configuration"):
        s, _, d = get(guess, quiet=True)
        if s == 200 and isinstance(d, dict) and d.get("token_endpoint") and d.get("authorization_endpoint"):
            return resource, d, (about or {}).get("scopes_supported")
    die(f"{parts.netloc} does not say how to sign in to it (no OAuth description found; the first answer was {status})")


def exchange(kept, form):
    """Asks the token endpoint; returns its answer or exits. Updates kept."""
    form = dict(form, client_id=kept["client_id"])
    if kept.get("client_secret"):
        form["client_secret"] = kept["client_secret"]
    if kept.get("resource"):
        form["resource"] = kept["resource"]
    status, _, d = get(kept["token_endpoint"], form=form)
    if status != 200 or not isinstance(d, dict) or not d.get("access_token"):
        why = d.get("error", "") if isinstance(d, dict) else ""
        if why == "invalid_grant":
            die(f"the sign-in has ended ({why}); sign in again", 2)
        die(f"the token endpoint answered {status} {why}".rstrip())
    kept["access_token"] = d["access_token"]
    if d.get("refresh_token"):
        kept["refresh_token"] = d["refresh_token"]
    lasts = int(d.get("expires_in") or 3600)
    kept["expires_at"], kept["lasts"] = int(time.time()) + lasts, lasts
    return lasts


def signin(key, url, port, client_id):
    resource, server, scopes = discover(url)
    if server.get("code_challenge_methods_supported") and "S256" not in server["code_challenge_methods_supported"]:
        die("the service does not offer the S256 proof this sign-in uses")
    back = f"http://127.0.0.1:{port}/callback"
    kept = {"url": url, "resource": resource, "token_endpoint": server["token_endpoint"]}
    if client_id:
        kept["client_id"] = client_id
    elif server.get("registration_endpoint"):
        status, _, d = get(server["registration_endpoint"], body={
            "client_name": "agent egress proxy", "redirect_uris": [back], "response_types": ["code"],
            "grant_types": ["authorization_code", "refresh_token"], "token_endpoint_auth_method": "none"})
        if status not in (200, 201) or not isinstance(d, dict) or not d.get("client_id"):
            die(f"the service did not register this client (it answered {status})")
        kept["client_id"] = d["client_id"]
        if d.get("client_secret"):
            kept["client_secret"] = d["client_secret"]
    else:
        die("the service does not register clients itself; give one with --client-id")

    proof = secrets.token_urlsafe(64)
    state = secrets.token_urlsafe(24)
    offered = server.get("scopes_supported") or scopes or []
    wanted = list(dict.fromkeys((scopes or offered) + (["offline_access"] if "offline_access" in offered else [])))
    ask = {"response_type": "code", "client_id": kept["client_id"], "redirect_uri": back, "state": state,
           "code_challenge": base64.urlsafe_b64encode(hashlib.sha256(proof.encode()).digest()).decode().rstrip("="),
           "code_challenge_method": "S256", "resource": resource}
    if wanted:
        ask["scope"] = " ".join(wanted)
    came = {}

    class Back(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            if not self.path.startswith("/callback") or q.get("state", [""])[0] != state:
                self.send_response(400); self.end_headers(); self.wfile.write(b"Not the sign-in that was started.")
                return
            came.update({k: v[0] for k, v in q.items()})
            self.send_response(200); self.send_header("Content-Type", "text/plain; charset=utf-8"); self.end_headers()
            self.wfile.write(("Signed in. You can close this tab." if "code" in came else "The sign-in was refused.").encode())

        def log_message(self, *args):
            pass

    listener = http.server.HTTPServer(("127.0.0.1", port), Back)
    listener.timeout = 5
    print(f"Open this in a browser on the machine that forwards port {port} here, and sign in:\n\n"
          f"  {server['authorization_endpoint']}?{urllib.parse.urlencode(ask)}\n\nWaiting up to ten minutes.", flush=True)
    until = time.time() + 600
    while not came and time.time() < until:
        listener.handle_request()
    listener.server_close()
    if "code" not in came:
        die("the sign-in was refused: " + came.get("error", "") if came else "nobody signed in within ten minutes")
    with locked(key):
        exchange(kept, {"grant_type": "authorization_code", "code": came["code"], "redirect_uri": back, "code_verifier": proof})
        kept["signed_in_at"] = int(time.time())
        save(key, kept)
    print(f"oauth-credential: {key}: signed in" + ("" if kept.get("refresh_token") else
          "; the service gave no way to renew, so this lasts only until the token runs out"))


def token(key):
    with locked(key):
        kept = load(key)
        for _ in range(4):
            left = kept.get("expires_at", 0) - time.time()
            if left > min(MARGIN, kept.get("lasts", 3600) / 2):
                break
            if not kept.get("refresh_token"):
                if left > 5:
                    break
                die(f"{key}: the token has run out and cannot be renewed; sign in again", 2)
            lasts = exchange(kept, {"grant_type": "refresh_token", "refresh_token": kept["refresh_token"]})
            save(key, kept)
            if lasts < 30:  # a service may answer a repeated renewal with a token to renew at once
                time.sleep(max(1, lasts))
        sys.stdout.write("Bearer " + kept["access_token"])


def status(key):
    kept = load(key)
    when = lambda t: time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(t)) if t else "unknown"
    print(f"{key}: {urllib.parse.urlsplit(kept.get('url', '')).netloc}, signed in {when(kept.get('signed_in_at'))}, "
          f"token until {when(kept.get('expires_at'))}, " + ("renewable" if kept.get("refresh_token") else "not renewable"))


def main():
    a = sys.argv[1:]
    if len(a) >= 3 and a[0] == "signin":
        port, client = 8765, None
        rest = a[3:]
        while rest:
            if rest[0] == "--port" and len(rest) > 1:
                port, rest = int(rest[1]), rest[2:]
            elif rest[0] == "--client-id" and len(rest) > 1:
                client, rest = rest[1], rest[2:]
            else:
                die(f"unknown option {rest[0]}")
        signin(a[1], a[2], port, client)
    elif len(a) == 2 and a[0] == "token":
        token(a[1])
    elif len(a) == 2 and a[0] == "status":
        status(a[1])
    else:
        die("usage: oauth-credential signin KEY URL [--port N] [--client-id ID] | token KEY | status KEY")


if __name__ == "__main__":
    main()
